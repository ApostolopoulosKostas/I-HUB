<?xml version="1.0" encoding="utf-8"?>
<ScrollView  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/brown">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">


    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I-HUB"
        android:textColor="@color/orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="40sp"
        android:layout_marginTop="30sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Εξυπηρέτηση"
        android:textSize="25sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="1dp"/>

    <TextView
        android:id="@+id/productSearchLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Αναζήτηση προϊόντος"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/productNumberInput"
        app:layout_constraintBottom_toTopOf="@id/productNumberInput"
        android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/productNumberInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Κωδικός προιόντος"
        android:inputType="number"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="70dp" />

    <TextView
    android:id="@+id/quantityLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Ποσότητα"
    android:textColor="@color/white"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="@id/quantityInput"
    app:layout_constraintBottom_toTopOf="@id/quantityInput"
    android:layout_marginBottom="1dp" />


    <EditText
        android:id="@+id/quantityInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:inputType="number"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textColor="@color/black"
        android:textColorHint="#777777"
        app:layout_constraintTop_toBottomOf="@id/productNumberInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/locationInput"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="15dp" />

    <TextView
    android:id="@+id/r_θεση"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Ράμπα"
    android:textColor="@color/white"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="@id/locationInput"
    app:layout_constraintBottom_toTopOf="@id/quantityInput"
    android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/locationInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:inputType="number"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textColor="@color/black"
        android:textColorHint="#777777"
        app:layout_constraintTop_toTopOf="@id/quantityInput"
        app:layout_constraintStart_toEndOf="@id/quantityInput"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="8dp"
        />

    <TextView
        android:id="@+id/messageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Μήνυμα"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/messageInput"
        app:layout_constraintBottom_toTopOf="@id/messageInput"
        android:layout_marginBottom="1dp" />

    <EditText
        android:id="@+id/messageInput"
        android:layout_width="360dp"
        android:layout_height="55dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:background="@android:drawable/edit_text"
        android:inputType="text"
        android:padding="10dp"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quantityInput" />


    <Button
        android:id="@+id/productInsert"
        android:layout_width="360dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/orange"
        android:text="+ Προσθήκη προϊόντος"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/messageInput" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/insertedProducts"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:clipToPadding="false"
        android:padding="4dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@+id/productInsert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        />


        <TextView
            android:id="@+id/departmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="Τμήμα παραλαβής"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/insertedProducts" />

    <EditText
        android:id="@+id/selectDepartment"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Επιλέξτε Τμήμα"
        android:inputType="number"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/departmentLabel"
        app:layout_constraintStart_toStartOf="@id/departmentLabel"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="1dp" />

    <Button
        android:id="@+id/sendRequest"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/orange"
        android:text="Αποστολή αιτήματος"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectDepartment"
        app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>