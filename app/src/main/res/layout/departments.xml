<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/brown"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I-HUB"
        android:textColor="@color/orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="40sp"
        android:layout_marginTop="40sp"/>

    <Button
        android:id="@+id/customerSupportButton"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Εξυπηρέτηση"
        android:textSize="18sp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp"/>

    <Button
        android:id="@+id/warehouseButton"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Αποθήκη"
        android:textSize="18sp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/customerSupportButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />
    <Button
        android:id="@+id/groceryButton"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Μανάβικο"
        android:textSize="18dp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/warehouseButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/fridgeButton"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Ψυγεία"
        android:textSize="18dp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/groceryButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        />

    <Button
        android:id="@+id/products"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="Είδη"
        android:textSize="18dp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/fridgeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"

        />





</androidx.constraintlayout.widget.ConstraintLayout>